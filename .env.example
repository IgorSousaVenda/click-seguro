# ── Desenvolvimento ──────────────────────────────────────────
# Copia este ficheiro para .env e preenche os valores.

DATABASE_URL="file:./dev.db"
BETTER_AUTH_URL="http://localhost:3000"

# Gera com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BETTER_AUTH_SECRET=""

# Testar noutro dispositivo da mesma rede. Lista separada por vírgulas.
# ORIGENS_DEV="192.168.0.115"
# ORIGENS_CONFIAVEIS="http://192.168.0.115:3000"

# ── Envio de e-mail (códigos de verificação) ─────────────────
# Sem SMTP_USER e SMTP_PASS a aplicação não falha: escreve o código nos
# registos do servidor. Chega para desenvolver e para demonstrar.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM='"Click Seguro" <nao-responder@clickseguro.ao>'

